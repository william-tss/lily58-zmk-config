/*
 * Lily58 Custom Keymap for SuperMini NRF52840 (nice!nano v2 compatible)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  DEL  |
// |   ~   |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   | ENTER | (Totoro ali)
// |  CTRL |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT | (Totoro verde)
//                     | ALT  |  FN  |  FN  |  SPACE |  | SPACE | CMD  |  CMD  | BSPC  |
//                                          (Polvere)|  |(SenzaV)| (Mei) | (Mei) |(Totoro)
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                     &kp N6    &kp N7   &kp N8    &kp N9  &kp N0   &kp DEL
&kp GRAVE &kp Q  &kp W  &kp E    &kp R    &kp T                      &kp Y     &kp U    &kp I     &kp O   &kp P    &kp BSLH
&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                      &kp H     &kp J    &kp K     &kp L   &kp SEMI &kp RET
&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B  &kp LBKT   &kp RBKT &kp N     &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &mo 1    &mo 1  &kp SPACE  &kp SPACE &kp LGUI &kp LGUI &kp BSPC
            >;
        };

        lower_layer {
            display-name = "FN";
// ------------------------------------------------------------------------------------------------------------
// | BT_CLR| BT1 | BT2 |  BT3 |OUT_TOG|     |                   |      |       |       |      |       |       |
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |       |     |     |      |      |      |                   | LEFT | DOWN  |  UP   | RIGHT|       |   '   |
// |       |     |     |      |      |      |   {    |  |   }   |  -   |  =    |  [    |  ]   |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &out OUT_TOG &trans                     &trans    &trans    &trans    &trans    &trans    &trans
&kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                     &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&trans     &trans       &trans       &trans       &trans       &trans                     &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &kp SQT
&trans     &trans       &trans       &trans       &trans       &trans    &kp LBRC &kp RBRC &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &trans    &trans
                                     &trans       &trans       &trans    &trans   &trans   &trans    &trans    &trans
            >;
        };

        raise_layer {
            display-name = "Media";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |     |      |      |      |                   | MUTE | VOL_DN| VOL_UP| PLAY |       |       |
// |       |     |     |      |      |      |                   | PREV |       |       | NEXT |       |       |
// |       |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&trans    &trans &trans &trans &trans &trans                 &trans     &trans       &trans       &trans   &trans &trans
&trans    &trans &trans &trans &trans &trans                 &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP &trans &trans
&trans    &trans &trans &trans &trans &trans                 &kp C_PREV &trans       &trans       &kp C_NEXT &trans &trans
&trans    &trans &trans &trans &trans &trans &trans   &trans &trans     &trans       &trans       &trans   &trans &trans
                        &trans &trans &trans &trans   &trans &trans     &trans       &trans
            >;
        };
    };
};
